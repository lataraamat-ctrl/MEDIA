    let summaryText = `🏆 REKAP BINTANG PERAN KELAS\nMisi: ${appState.mission}\n\n`;
    [...appState.groups].sort((a, b) => b.stars - a.stars).forEach(g => {
        summaryText += `• ${g.name}: ${g.stars} Bintang\n`;
    });
    fallbackCopyText(summaryText);
}

function fallbackCopyText(text) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
            showClassroomToast("📋 Ringkasan Disalin!", "Teks rekapitulasi berhasil disalin.");
        }).catch(() => doFallbackCopy(text));
    } else {
        doFallbackCopy(text);
    }
}

function doFallbackCopy(text) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    try { document.execCommand('copy'); showClassroomToast("📋 Ringkasan Disalin!", "Teks rekapitulasi berhasil disalin."); }
    catch(e) { showClassroomToast("⚠️ Gagal Menyalin", "Silakan salin manual."); }
    document.body.removeChild(textarea);
}

