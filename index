    renderProfile();
    playSFX('bell');
    showClassroomToast("🔄 Profil Direset", "Biodata dikembalikan ke pengaturan awal.");
}

/* ---------- Render Tampilan View Mode ---------- */
function renderProfile() {
    document.getElementById('disp-prof-name').textContent = creatorProfile.name || '-';
    document.getElementById('disp-prof-nim').textContent = creatorProfile.nim || '-';
    document.getElementById('disp-prof-lptk').textContent = creatorProfile.lptk || '-';
    document.getElementById('disp-prof-program').textContent = creatorProfile.program || '-';
    document.getElementById('disp-prof-school').textContent = creatorProfile.school || '-';
    document.getElementById('disp-prof-motto').textContent = creatorProfile.motto
        ? `"${creatorProfile.motto}"`
        : '"Belum ada visi yang dituliskan."';

    const photoContainer = document.getElementById('container-prof-photo');
    if (!photoContainer) return;

    if (creatorProfile.photoUrl) {
        const img = document.createElement('img');
        img.src = creatorProfile.photoUrl;
        img.alt = creatorProfile.name;
        img.className = 'w-full h-full object-cover rounded-xl';
        img.onerror = () => {
            photoContainer.innerHTML = '<i class="fa-solid fa-user-graduate"></i>';
        };
        photoContainer.innerHTML = '';
        photoContainer.appendChild(img);
    } else {
        photoContainer.innerHTML = '<i class="fa-solid fa-user-graduate"></i>';
    }
}

/* ===================================================================
 * UTILITIES
 * =================================================================== */
function escapeHtml(str) {
    if (typeof str !== 'string') return '';
    return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[m]));
}

/* ===================================================================
 * INIT
 * =================================================================== */
window.addEventListener('DOMContentLoaded', function() {
    renderTeacherPanel();
    renderProjectorView();
    updateTimerDisplay();
    renderProfile();

    // Preload audio context on first user gesture
    document.body.addEventListener('click', function initAudio() {
        getAudioContext();
        document.body.removeEventListener('click', initAudio);
    }, { once: true });
});
</script>
