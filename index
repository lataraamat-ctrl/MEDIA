function toggleTimer() {
    const btnToggle = document.getElementById('btn-timer-toggle');
    const badge = document.getElementById('timer-status-badge');

    if (isTimerRunning) {
        clearInterval(timerInterval);
        isTimerRunning = false;
        btnToggle.innerHTML = '<i class="fa-solid fa-play mr-1"></i> Start';
        btnToggle.className = 'flex-1 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition';
        badge.textContent = 'Paused';
        badge.className = 'text-[10px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300';
    } else {
        getAudioContext();
        isTimerRunning = true;
        btnToggle.innerHTML = '<i class="fa-solid fa-pause mr-1"></i> Pause';
        btnToggle.className = 'flex-1 py-1.5 bg-amber-600 hover:bg-amber-500 text-white rounded-lg text-xs font-bold transition';
        badge.textContent = 'Running';
        badge.className = 'text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300';

        timerInterval = setInterval(() => {
            if (timerSeconds > 0) {
                timerSeconds--;
                updateTimerDisplay();
            } else {
                clearInterval(timerInterval);
                isTimerRunning = false;
                playSFX('bell');
                showClassroomToast("⏱️ Waktu Diskusi Selesai!", "Mari bersiap untuk presentasi dan apresiasi peran!");
                btnToggle.innerHTML = '<i class="fa-solid fa-play mr-1"></i> Start';
                btnToggle.className = 'flex-1 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition';
                badge.textContent = 'Done';
                badge.className = 'text-[10px] px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300';
            }
        }, 1000);
    }
}

function resetTimer() {
    clearInterval(timerInterval);
    isTimerRunning = false;
    const mins = Math.max(1, Math.min(120, parseInt(document.getElementById('input-timer-mins').value) || 15));
    timerSeconds = mins * 60;
    updateTimerDisplay();
    const btn = document.getElementById('btn-timer-toggle');
    btn.innerHTML = '<i class="fa-solid fa-play mr-1"></i> Start';
    btn.className = 'flex-1 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition';
    const badge = document.getElementById('timer-status-badge');
    badge.textContent = 'Ready';
    badge.className = 'text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400';
}

function updateTimerDisplay() {
    const mins = Math.floor(timerSeconds / 60);
    const secs = timerSeconds % 60;
    document.getElementById('display-timer').textContent = 
        `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
}

