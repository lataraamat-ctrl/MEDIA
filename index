<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KelasAktif - Role Assigner & Team Tracker Gen Alpha</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff', 100: '#e0e7ff', 500: '#6366f1',
                            600: '#4f46e5', 700: '#4338ca',
                        },
                        role: {
                            writer: '#3b82f6', checker: '#10b981', timer: '#f59e0b',
                            speaker: '#ec4899', leader: '#8b5cf6', cleaner: '#14b8a6'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        outfit: ['Outfit', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0f172a; color: #f8fafc; }
        .heading-font { font-family: 'Outfit', sans-serif; }
        .glass-card { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
        .glass-card-light { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08); }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
        ::-webkit-scrollbar-thumb { background: rgba(99, 102, 241, 0.4); border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(99, 102, 241, 0.8); }
        @keyframes shufflePulse {
            0% { transform: scale(1) rotate(0deg); }
            25% { transform: scale(1.03) rotate(-1deg); }
            50% { transform: scale(0.97) rotate(1deg); }
            75% { transform: scale(1.02) rotate(-0.5deg); }
            100% { transform: scale(1) rotate(0deg); }
        }
        .shuffling { animation: shufflePulse 0.3s ease-in-out infinite; }
        @keyframes starGlow {
            0%, 100% { filter: drop-shadow(0 0 5px rgba(245, 158, 11, 0.6)); }
            50% { filter: drop-shadow(0 0 15px rgba(245, 158, 11, 0.9)); }
        }
        .star-active { animation: starGlow 2s infinite; }
        @keyframes toastSlide {
            from { transform: translate(-50%, 20px); opacity: 0; }
            to { transform: translate(-50%, 0); opacity: 1; }
        }
        #classroom-toast:not(.hidden) { animation: toastSlide 0.3s ease-out; }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-brand-500 selection:text-white">

<header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-40 px-4 py-3">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-pink-500 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-brand-500/30">
                <i class="fa-solid fa-users-gear"></i>
            </div>
            <div>
                <h1 class="heading-font text-lg font-bold bg-gradient-to-r from-white via-indigo-200 to-indigo-400 bg-clip-text text-transparent">
                    KelasAktif <span class="text-xs px-2 py-0.5 rounded-full bg-brand-500/20 text-brand-300 border border-brand-500/30 font-normal">Gen Alpha PPG</span>
                </h1>
                <p class="text-xs text-slate-400">Inovasi Kelompok Lintas Mapel SD (Kelas 1-6)</p>
            </div>
        </div>

        <div class="flex items-center bg-slate-800 p-1 rounded-xl border border-slate-700/60 text-xs font-medium">
            <button id="btn-view-split" onclick="switchView('split')" class="px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition-all bg-brand-600 text-white shadow">
                <i class="fa-solid fa-columns"></i><span class="hidden sm:inline">Split View</span>
            </button>
            <button id="btn-view-hp" onclick="switchView('hp')" class="px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition-all text-slate-400 hover:text-white">
                <i class="fa-solid fa-mobile-screen"></i><span>HP Guru</span>
            </button>
            <button id="btn-view-projector" onclick="switchView('projector')" class="px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition-all text-slate-400 hover:text-white">
                <i class="fa-solid fa-tv"></i><span>Proyektor Kelas</span>
            </button>
        </div>

        <div class="flex items-center gap-2">
            <button onclick="toggleAudio()" id="btn-sound" class="p-2 w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 flex items-center justify-center transition" title="Toggle Suara">
                <i class="fa-solid fa-volume-high" id="icon-sound"></i>
            </button>
            <button onclick="openProfileModal()" class="px-3 py-1.5 rounded-lg bg-indigo-950/80 hover:bg-indigo-900 border border-indigo-700/60 text-xs font-semibold text-indigo-200 flex items-center gap-1.5 transition shadow-sm">
                <i class="fa-solid fa-user-graduate text-amber-400"></i><span>Profil Pembuat</span>
            </button>
            <button onclick="openConfigModal()" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-slate-200 flex items-center gap-1.5 transition">
                <i class="fa-solid fa-sliders text-brand-400"></i><span>Pengaturan Kelas</span>
            </button>
        </div>
    </div>
</header>

<main class="flex-1 p-3 md:p-6 max-w-7xl w-full mx-auto grid grid-cols-1 md:grid-cols-12 gap-6 transition-all" id="app-viewport">
    
    <!-- LEFT PANEL -->
    <section id="panel-hp" class="md:col-span-5 glass-card rounded-2xl p-4 md:p-5 flex flex-col gap-5 border border-slate-700/60 shadow-2xl">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
                <h2 class="heading-font text-base font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-mobile-screen-button text-brand-400"></i>
                    Panel Kontrol HP Wali Kelas
                </h2>
            </div>
            <span id="label-active-class" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-800 text-indigo-300 border border-slate-700">
                Kelas 4-6 SD (Tinggi)
            </span>
        </div>

        <div class="bg-gradient-to-br from-indigo-900/40 to-slate-900/80 border border-indigo-500/30 rounded-xl p-4 flex flex-col gap-3">
            <div class="flex justify-between items-center">
                <div>
                    <h3 class="font-bold text-sm text-indigo-200">1. Pembagian Peran</h3>
                    <p class="text-xs text-slate-400">Acak peran otomatis ke seluruh kelompok</p>
                </div>
                <i class="fa-solid fa-dice-d20 text-2xl text-indigo-400"></i>
            </div>
            <button onclick="triggerSpinRoles()" id="btn-spin" class="w-full py-3 px-4 bg-gradient-to-r from-brand-600 via-indigo-600 to-purple-600 hover:from-brand-500 hover:to-purple-500 active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-500/25 flex items-center justify-center gap-2 transition duration-200">
                <i class="fa-solid fa-shuffle text-base"></i>
                <span>Acak & Bagikan Peran Sekarang!</span>
            </button>
        </div>

        <div class="glass-card-light rounded-xl p-3.5 flex flex-col gap-2.5">
            <label for="input-mission" class="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                <i class="fa-solid fa-bullhorn text-amber-400"></i>
                Tulis Misi / Instruksi Utama Kelas:
            </label>
            <div class="flex gap-2">
                <input type="text" id="input-mission" value="Diskusi Kelompok: Analisis Rantai Makanan & Buat Diagramnya!" placeholder="Contoh: Kerjakan Soal Hal 45..." class="flex-1 bg-slate-900/90 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-brand-500">
                <button onclick="updateMission()" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-semibold border border-slate-700 transition">
                    Kirim
                </button>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-2.5">
            <div class="glass-card-light rounded-xl p-3 flex flex-col justify-between gap-2">
                <div class="text-xs font-semibold text-slate-300 flex items-center justify-between">
                    <span><i class="fa-solid fa-clock text-indigo-400 mr-1"></i> Timer Fokus</span>
                    <span id="timer-status-badge" class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400">Ready</span>
                </div>
                <div class="flex items-center gap-1.5 my-0.5">
                    <input type="number" id="input-timer-mins" min="1" max="120" value="15" class="w-14 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-xs text-white text-center focus:outline-none focus:border-brand-500">
                    <span class="text-[11px] text-slate-400">menit</span>
                    <button onclick="applyCustomTimer()" class="px-2 py-1 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-[11px] font-semibold transition">Set</button>
                </div>
                <div class="flex items-center gap-1.5">
                    <button onclick="toggleTimer()" id="btn-timer-toggle" class="flex-1 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition">
                        <i class="fa-solid fa-play mr-1"></i> Start
                    </button>
                    <button onclick="resetTimer()" class="p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs transition border border-slate-700" title="Reset">
                        <i class="fa-solid fa-rotate-left"></i>
                    </button>
                </div>
            </div>

            <div class="glass-card-light rounded-xl p-3 flex flex-col justify-between gap-2">
                <div class="text-xs font-semibold text-slate-300 flex items-center justify-between">
                    <span><i class="fa-solid fa-bell text-rose-400 mr-1"></i> Suara Isyarat</span>
                </div>
                <div class="flex gap-1.5">
                    <button onclick="playSFX('bell')" class="flex-1 py-1.5 bg-slate-800 hover:bg-slate-700 text-amber-300 rounded-lg text-xs font-semibold border border-slate-700 transition" title="Bel Perhatian">🔔 Bel</button>
                    <button onclick="playSFX('cheer')" class="flex-1 py-1.5 bg-slate-800 hover:bg-slate-700 text-pink-300 rounded-lg text-xs font-semibold border border-slate-700 transition" title="Tepuk Tangan">👏 Sorak</button>
                </div>
            </div>
        </div>

        <div class="flex-1 flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <h3 class="font-bold text-xs uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-star text-amber-400"></i> Apresiasi Peran Kelompok
                </h3>
                <span class="text-[11px] text-slate-500">Apresiasi Poin Kelompok</span>
            </div>
            <div id="teacher-group-list" class="space-y-2.5 overflow-y-auto max-h-[320px] pr-1"></div>
        </div>

        <div class="pt-2 border-t border-slate-800 flex justify-between items-center text-xs">
            <button onclick="openSummaryModal()" class="text-indigo-400 hover:text-indigo-300 font-medium flex items-center gap-1">
                <i class="fa-solid fa-chart-pie"></i> Lihat Rekapitulasi Bintang
            </button>
        </div>
    </section>

    <!-- RIGHT PANEL -->
    <section id="panel-projector" class="md:col-span-7 glass-card rounded-2xl p-4 md:p-6 flex flex-col gap-6 border border-slate-700/60 shadow-2xl relative overflow-hidden bg-slate-950/80">
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-brand-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-pink-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-900/90 border border-slate-800 rounded-xl p-4 shadow-inner relative z-10">
            <div>
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-bold uppercase tracking-wider">
                        <i class="fa-solid fa-bullhorn mr-1"></i> Misi Utama Hari Ini
                    </span>
                </div>
                <h2 id="display-mission-text" class="heading-font text-base md:text-xl font-bold text-white mt-1">
                    Diskusi Kelompok: Analisis Rantai Makanan & Buat Diagramnya!
                </h2>
            </div>

            <div class="flex items-center gap-3 bg-slate-950 px-4 py-2.5 rounded-xl border border-slate-800 shadow-md">
                <div class="text-right">
                    <span class="text-[10px] uppercase font-semibold text-slate-400 block tracking-wider">Sisa Waktu Sesi</span>
                    <span id="display-timer" class="heading-font text-2xl font-black text-amber-400 tracking-wider">15:00</span>
                </div>
                <div class="w-10 h-10 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 text-lg">
                    <i class="fa-solid fa-stopwatch" id="icon-timer-display"></i>
                </div>
            </div>
        </div>

        <div id="projector-group-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4 flex-1 relative z-10"></div>

        <div id="classroom-toast" class="hidden absolute bottom-6 left-1/2 -translate-x-1/2 z-30 bg-gradient-to-r from-amber-500 via-pink-500 to-indigo-600 text-white px-6 py-3 rounded-2xl shadow-2xl border-2 border-white/20 flex items-center gap-3">
            <i class="fa-solid fa-trophy text-2xl text-amber-200"></i>
            <div>
                <h4 id="toast-title" class="font-extrabold text-sm heading-font">Selamat Kelompok 1!</h4>
                <p id="toast-desc" class="text-xs text-amber-100">Mendapatkan +10 Bintang Kerjasama Peran!</p>
            </div>
        </div>
    </section>
</main>

<!-- ============================================================
     MODAL 1: CONFIGURATION
     ============================================================ -->
<div id="modal-config" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 hidden items-center justify-center p-4">
    <div class="glass-card rounded-2xl max-w-2xl w-full p-5 md:p-6 border border-slate-700 shadow-2xl flex flex-col gap-4 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <h3 class="heading-font text-lg font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-gear text-brand-400"></i> Pengaturan Kelas, Data Siswa & Peran
            </h3>
            <button onclick="closeConfigModal()" class="text-slate-400 hover:text-white text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="flex border-b border-slate-800 text-xs font-semibold gap-2 pb-2 overflow-x-auto">
            <button onclick="switchConfigTab('tab-roster')" id="tab-btn-roster" class="px-3 py-1.5 rounded-lg bg-brand-600 text-white flex items-center gap-1.5 transition whitespace-nowrap">
                <i class="fa-solid fa-users"></i> 1. Roster & Pembagian Kelompok
            </button>
            <button onclick="switchConfigTab('tab-roles')" id="tab-btn-roles" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white flex items-center gap-1.5 transition whitespace-nowrap">
                <i class="fa-solid fa-masks-theater"></i> 2. Form Input Peran
            </button>
            <button onclick="switchConfigTab('tab-manual')" id="tab-btn-manual" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white flex items-center gap-1.5 transition whitespace-nowrap">
                <i class="fa-solid fa-pen-to-square"></i> 3. Edit Kelompok Manual
            </button>
        </div>

        <div id="tab-roster" class="space-y-4">
            <div class="space-y-1.5">
                <label for="input-roster-text" class="text-xs font-semibold text-indigo-300 flex items-center justify-between">
                    <span><i class="fa-solid fa-clipboard-user mr-1"></i> Form Input Data Seluruh Siswa Kelas:</span>
                    <span class="text-[10px] text-slate-400 font-normal">Pisahkan nama dengan koma atau baris baru</span>
                </label>
                <textarea id="input-roster-text" rows="3" placeholder="Contoh: Aditya, Nabila, Rian, Siti..." class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-brand-500"></textarea>
            </div>

            <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3.5 space-y-3">
                <h4 class="text-xs font-bold text-slate-200 flex items-center gap-1.5">
                    <i class="fa-solid fa-calculator text-amber-400"></i> Pengaturan Jumlah Kelompok & Kapasitas Siswa
                </h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="input-num-groups" class="text-[11px] font-semibold text-slate-300 block mb-1">Jumlah Kelompok:</label>
                        <input type="number" id="input-num-groups" min="1" max="12" value="4" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-brand-500">
                    </div>
                    <div>
                        <label for="input-students-per-group" class="text-[11px] font-semibold text-slate-300 block mb-1">Max Siswa Per Kelompok:</label>
                        <input type="number" id="input-students-per-group" min="1" max="10" value="4" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-brand-500">
                    </div>
                </div>
                <button onclick="autoGenerateGroups()" class="w-full py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 transition">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>Bagi Kelompok Otomatis dari Data Siswa</span>
                </button>
            </div>
        </div>

        <div id="tab-roles" class="space-y-4 hidden">
            <div class="space-y-2">
                <label class="text-xs font-semibold text-slate-300 block">Pilih Sumber & Preset Peran:</label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                    <button onclick="selectRoleMode('low')" id="preset-btn-low" class="p-2.5 rounded-xl border text-left transition flex flex-col gap-1 bg-slate-800/80 border-slate-700 hover:border-brand-500">
                        <span class="font-bold text-xs text-indigo-300">🎨 Kelas 1-3 SD</span>
                        <span class="text-[10px] text-slate-400">4 Peran Visual Sederhana</span>
                    </button>
                    <button onclick="selectRoleMode('high')" id="preset-btn-high" class="p-2.5 rounded-xl border text-left transition flex flex-col gap-1 bg-slate-800/80 border-slate-700 hover:border-brand-500">
                        <span class="font-bold text-xs text-purple-300">🔍 Kelas 4-6 SD</span>
                        <span class="text-[10px] text-slate-400">4 Peran Keterampilan Proses</span>
                    </button>
                    <button onclick="selectRoleMode('custom')" id="preset-btn-custom" class="p-2.5 rounded-xl border text-left transition flex flex-col gap-1 bg-slate-800/80 border-slate-700 hover:border-brand-500">
                        <span class="font-bold text-xs text-amber-300">✨ Peran Kustom</span>
                        <span class="text-[10px] text-slate-400">Dibuat Guru Sendiri</span>
                    </button>
                </div>
            </div>

            <div id="custom-role-builder" class="bg-slate-900 border border-slate-800 rounded-xl p-3.5 space-y-3">
                <h4 class="text-xs font-bold text-amber-300 flex items-center gap-1.5">
                    <i class="fa-solid fa-plus-circle"></i> Form Input Peran Kustom Baru
                </h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <input type="text" id="input-custom-title" placeholder="Nama Peran (misal: Si Pemimpin)" class="bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white">
                    <select id="input-custom-icon" class="bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white">
                        <option value="fa-crown">👑 Ikon Mahkota / Pemimpin</option>
                        <option value="fa-pen-to-square">📝 Ikon Pensil / Notulis</option>
                        <option value="fa-magnifying-glass">🔍 Ikon Detektif / Pengecek</option>
                        <option value="fa-hourglass-half">⏱️ Ikon Jam / Waktu</option>
                        <option value="fa-chalkboard-user">📢 Ikon Presenter / Bicara</option>
                        <option value="fa-paintbrush">🎨 Ikon Gambar / Lukis</option>
                        <option value="fa-broom">🧹 Ikon Rapih / Bersih</option>
                        <option value="fa-shield-halved">🛡️ Ikon Penjaga / Ketertiban</option>
                    </select>
                </div>
                <input type="text" id="input-custom-mission" placeholder="Instruksi Tugas Peran (misal: Memimpin diskusi)" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white">
                <button onclick="addCustomRole()" class="w-full py-2 bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold text-xs rounded-lg transition">
                    + Tambahkan ke Daftar Peran Kustom
                </button>
            </div>

            <div class="space-y-2">
                <h4 class="text-xs font-semibold text-slate-300">Daftar Peran Aktif:</h4>
                <div id="active-roles-list" class="space-y-2 max-h-[180px] overflow-y-auto pr-1"></div>
            </div>
        </div>

        <div id="tab-manual" class="space-y-3 hidden">
            <div class="flex justify-between items-center">
                <label class="text-xs font-semibold text-slate-300">Daftar Kelompok & Anggota Siswa:</label>
                <button onclick="addNewGroup()" class="px-2.5 py-1 bg-brand-600 hover:bg-brand-500 text-white rounded-lg text-xs font-semibold transition flex items-center gap-1">
                    <i class="fa-solid fa-plus"></i> Tambah Kelompok
                </button>
            </div>
            <div id="config-group-editor" class="space-y-3"></div>
        </div>

        <div class="pt-3 border-t border-slate-800 flex justify-end gap-2">
