/* ---------- Upload Foto dari File HP/Laptop ---------- */
function handlePhotoUpload(event) {
    const file = event.target.files && event.target.files[0];
    if (!file) return;

    if (!file.type.startsWith('image/')) {
        showClassroomToast("⚠️ File Tidak Valid", "Mohon pilih file gambar (JPG/PNG).");
        return;
    }

    if (file.size > 2 * 1024 * 1024) {
        showClassroomToast("⚠️ File Terlalu Besar", "Maksimal ukuran foto 2MB.");
        return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
        tempPhotoUrl = e.target.result;
        updateEditPhotoPreview();
        showClassroomToast("📸 Foto Dipilih", "Klik 'Simpan Profil' untuk menerapkan.");
    };
    reader.onerror = () => showClassroomToast("⚠️ Gagal Membaca", "Coba pilih file lain.");
    reader.readAsDataURL(file);
}

function clearPhoto() {
    tempPhotoUrl = "";
    document.getElementById('edit-prof-photo-file').value = '';
    updateEditPhotoPreview();
}

function updateEditPhotoPreview() {
    const preview = document.getElementById('edit-photo-preview');
    if (!preview) return;

    if (tempPhotoUrl) {
        preview.innerHTML = `<img src="${tempPhotoUrl}" alt="Preview" class="w-full h-full object-cover rounded-xl">`;
    } else {
        preview.innerHTML = `<i class="fa-solid fa-user-graduate"></i>`;
    }
}

