function autoGenerateGroups() {
    const rawText = document.getElementById('input-roster-text').value;
    const numGroups = Math.max(1, parseInt(document.getElementById('input-num-groups').value) || 4);
    const maxStudents = Math.max(1, parseInt(document.getElementById('input-students-per-group').value) || 4);

    appState.allStudentsText = rawText;
    const names = rawText.split(/[\n,]+/).map(n => n.trim()).filter(n => n.length > 0);

    if (names.length === 0) {
        showClassroomToast("⚠️ Data Siswa Kosong", "Masukkan daftar nama siswa terlebih dahulu.");
        return;
    }

    const newGroups = [];
    for (let i = 0; i < numGroups; i++) {
        newGroups.push({ id: `g_${i + 1}_${Date.now()}`, name: `Kelompok ${i + 1}`, stars: 20, students: [] });
    }

    names.forEach((studentName, index) => {
        const groupIndex = index % numGroups;
        if (newGroups[groupIndex].students.length < maxStudents) {
            newGroups[groupIndex].students.push({ name: studentName, role: null });
        }
    });

    appState.groups = newGroups;
    renderConfigEditor();
    switchConfigTab('tab-manual');
    showClassroomToast("✨ Kelompok Dibuat!", `Berhasil membagi ${names.length} siswa ke dalam ${numGroups} kelompok.`);
}

