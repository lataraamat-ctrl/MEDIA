/* ===================================================================
 * AUDIO SYNTHESIZER
 * =================================================================== */
let audioCtx = null;

function getAudioContext() {
    if (!audioCtx) {
        try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
        catch(e) { console.warn("AudioContext not supported"); return null; }
    }
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
}

function playSFX(type) {
    if (!audioEnabled) return;
    try {
        const ctx = getAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;

        const playTone = (freq, duration, typeOsc = 'sine', vol = 0.1, delay = 0) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = typeOsc;
            osc.frequency.setValueAtTime(freq, now + delay);
            gain.gain.setValueAtTime(vol, now + delay);
            gain.gain.exponentialRampToValueAtTime(0.001, now + delay + duration);
            osc.connect(gain); gain.connect(ctx.destination);
            osc.start(now + delay); osc.stop(now + delay + duration);
        };

        switch(type) {
            case 'spin': playTone(400, 0.1, 'sine', 0.1); break;
            case 'chime':
            case 'star':
                [523.25, 659.25, 783.99, 1046.50].forEach((f, i) => playTone(f, 0.3, 'triangle', 0.2, i * 0.08));
                break;
            case 'penalty':
            case 'buzz':
                playTone(180, 0.3, 'sawtooth', 0.2);
                setTimeout(() => playTone(110, 0.3, 'sawtooth', 0.15), 100);
                break;
            case 'bell':
                playTone(880, 1.2, 'sine', 0.3);
                playTone(1760, 0.8, 'sine', 0.1, 0.05);
                break;
            case 'cheer':
                [440, 554.37, 659.25, 880].forEach(f => playTone(f, 0.6, 'sawtooth', 0.12));
                break;
        }
    } catch(e) { console.warn("Audio error:", e); }
}

function toggleAudio() {
    audioEnabled = !audioEnabled;
    const icon = document.getElementById('icon-sound');
    if (audioEnabled) {
        icon.className = 'fa-solid fa-volume-high';
        playSFX('bell');
    } else {
        icon.className = 'fa-solid fa-volume-xmark text-rose-400';
    }
}

/* ===================================================================
 * ROLE ASSIGNMENT
 * =================================================================== */
function getActiveRoles() {
    if (roleMode === 'custom' && appState.customRoles && appState.customRoles.length > 0) {
        return appState.customRoles;
    }
    return ROLE_PRESETS[roleMode] || ROLE_PRESETS['high'];
}

function triggerSpinRoles() {
    if (isSpinning) return;
    const availableRoles = getActiveRoles();
    if (!availableRoles || availableRoles.length === 0) {
        showClassroomToast("⚠️ Peran Kosong", "Silakan atur atau tambahkan peran terlebih dahulu.");
        return;
    }

    const btnSpin = document.getElementById('btn-spin');
    isSpinning = true;
    btnSpin.disabled = true;
    btnSpin.classList.add('opacity-75', 'cursor-not-allowed');

    const projectorGrid = document.getElementById('projector-group-grid');
    projectorGrid.classList.add('shuffling');

    let spins = 0;
    const maxSpins = 12;

    const spinInterval = setInterval(() => {
        spins++;
        playSFX('spin');
        appState.groups.forEach(group => {
            const shuffledRoles = [...availableRoles].sort(() => Math.random() - 0.5);
            group.students.forEach((student, index) => {
                student.role = shuffledRoles[index % shuffledRoles.length];
            });
        });
        renderProjectorView();

        if (spins >= maxSpins) {
            clearInterval(spinInterval);
            projectorGrid.classList.remove('shuffling');
            isSpinning = false;
            btnSpin.disabled = false;
            btnSpin.classList.remove('opacity-75', 'cursor-not-allowed');
            playSFX('cheer');
            triggerConfetti();
            showClassroomToast("🎉 Peran Berhasil Dibagikan!", "Setiap siswa memiliki peran khusus. Mari laksanakan tugas kelompok!");
        }
    }, 120);
}

function triggerConfetti() {
